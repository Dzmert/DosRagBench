#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# DoSRAGBench external baseline: Shafran et al. blocker / jamming documents
# (arXiv:2406.05870, USENIX Sec 2025).
#
# This is NOT one of our attacks -- it is the comparison point Bao asked for
# against a specific paper rather than a survey. Its threat model is STRONGER
# than ours: it optimises against the target RAG via black-box feedback, where
# our attacks are optimisation-free.
#
# Cost is the thing to watch. MEASURED throughput from the n=5 smoke test
# (dosrag_blocker.o8923941, 25 iters x 8 batch):
#   base    ~175 oracle gens/query x ~5.5s  = ~16 min/query (full 256-tok answers)
#   aligned ~169 oracle gens/query x ~1.0s  = ~2.7 min/query (refuses early)
# => 50 queries needs ~16h total, which is why walltime is 24h (NOT the old 12h;
#    at 12h the base side alone would hit the wall and die mid-run).
# For a fast 12h run instead, drop to NUM_QUERIES=30 and add -l walltime=12:00:00.
#
# Budget note: 25 iters x 8 batch = 200 candidate evals/query, far below the
# paper's 1000 x 32. Report this run as budget-limited -- it is a LOWER BOUND on
# the optimised attacker, which is the honest and still-useful framing.
#
# Submit (50 queries, 24h):  qsub -v NUM_QUERIES=50 scripts/run_blocker_katana.pbs
# Watch:   qstat -u $USER
# ─────────────────────────────────────────────────────────────────────────────
#PBS -N dosrag_blocker
#PBS -l select=1:ncpus=8:ngpus=1:mem=90gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

PAIR=${PAIR:-llama-3.1-8b}
NUM_QUERIES=${NUM_QUERIES:-50}
ITERS=${ITERS:-25}
BATCH=${BATCH:-8}
TOKENS=${TOKENS:-50}

PROJECT="$HOME/thesis_b/DosRagBench"
cd "$PROJECT"

if [ -f .env ]; then
    set -a; source .env; set +a
fi

export HF_HOME="/srv/scratch/$USER/hf_cache"
export HF_DATASETS_CACHE="/srv/scratch/$USER/hf_cache/datasets"
export DOSRAGBENCH_CACHE="/srv/scratch/$USER/dosragbench_cache"
mkdir -p "$HF_HOME" "$HF_DATASETS_CACHE" "$DOSRAGBENCH_CACHE"

module load python/3.11
source .venv/bin/activate

echo "=========================================="
echo "Blocker baseline (Shafran et al.)"
echo "pair=$PAIR queries=$NUM_QUERIES iters=$ITERS batch=$BATCH tokens=$TOKENS"
echo "worst case: $((ITERS * BATCH * NUM_QUERIES * 2)) generations across both sides"
echo "Node:    $(hostname)"
echo "Started: $(date)"
echo "=========================================="

python3 scripts/run_attack.py \
    --category BLOCKER \
    --model-pair "$PAIR" \
    --num-queries "$NUM_QUERIES" \
    --blocker-iters "$ITERS" \
    --blocker-batch "$BATCH" \
    --blocker-tokens "$TOKENS"

echo "Finished: $(date)"
